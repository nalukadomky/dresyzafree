# Supabase – povinné pro produkci (vezměte z dashboard.supabase.com → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://VAS_PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT pro přihlášení – POVINNÉ v produkci, silné náhodné heslo
JWT_SECRET=vytvorte-silne-nahodne-heslo-min-32-znaku

# Google Cloud Console – Maps; pro Gemini Image Generation zapni „Generative Language API“ + Imagen
NEXT_PUBLIC_GOOGLE_API_KEY=
GEMINI_IMAGE_API_KEY=

# Google AI Studio (Gemini) – aistudio.google.com
GOOGLE_AI_STUDIO_API_KEY=

# Pexels – fotobanka v webbuilderu (zdarma na pexels.com/api)
PEXELS_API_KEY=

# Volitelné (migrace, skripty)
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DATABASE_URL=
# MIGRATE_SECRET=
